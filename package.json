{
  "name": "garmin-mcp",
  "version": "0.1.0",
  "description": "Local read-only Garmin activity MCP server",
  "private": true,
  "license": "MIT",
  "keywords": [
    "mcp",
    "garmin"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "format": "prettier . --write && npm run format:python",
    "format:check": "prettier . --check && npm run format:python:check",
    "lint": "eslint . --max-warnings=0 && npm run lint:python",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run && npm run test:python",
    "test:python": "node --import tsx scripts/python-tests.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "smoke": "tsx src/smoke.ts",
    "auth:login": "tsx src/auth/cli.ts login",
    "auth:status": "tsx src/auth/cli.ts status",
    "auth:logout": "tsx src/auth/cli.ts logout",
    "format:python": "node --import tsx scripts/python-quality.ts format",
    "format:python:check": "node --import tsx scripts/python-quality.ts format-check",
    "lint:python": "node --import tsx scripts/python-quality.ts lint"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.6.0",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.1.11"
  }
}
